# =============================================================================
# greggorpages - Environment Configuration
# =============================================================================
# Copy this file to .env.local (for local dev) or set values in your container.
# Administrative API endpoints use API_KEY. The ForwardAuth access endpoints
# under /api/access/* intentionally use the browser/app session instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Master API Key for administrative API endpoints
# -----------------------------------------------------------------------------
API_KEY=your-very-secret-master-api-key

# -----------------------------------------------------------------------------
# Access Gateway / Traefik ForwardAuth
# -----------------------------------------------------------------------------
# disabled | local | app
#   local = greggorpages authenticates users itself
#   app   = delegate verification to the protected application's auth endpoint
# -----------------------------------------------------------------------------
ACCESS_AUTH_MODE=disabled

# Browser login path served by greggorpages in local mode.
ACCESS_LOGIN_PATH=/access/login
ACCESS_LOGIN_BRAND=Meyer Media
ACCESS_LOGIN_TITLE=Geschützter Bereich
ACCESS_LOGIN_SUBTITLE=Melde dich mit einem berechtigten Konto an, um fortzufahren.

# auto = redirect browser navigations, return 401 to API/fetch requests
# redirect = always redirect unauthenticated requests to a login page
# 401 = never redirect
ACCESS_UNAUTHORIZED_MODE=auto

# -----------------------------------------------------------------------------
# Local Access Gateway mode
# -----------------------------------------------------------------------------
# Required when ACCESS_AUTH_MODE=local. Generate a strong value, e.g.:
#   openssl rand -base64 48
# A secret shorter than 32 characters is rejected.
ACCESS_SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_SESSION_MAX_AGE_SECONDS=28800
ACCESS_SESSION_BIND_HOST=true

# Cookie defaults are secure for production. ACCESS_COOKIE_DOMAIN is optional;
# omit it to use a host-only __Host- cookie in production.
# ACCESS_COOKIE_NAME=greggor-access
# ACCESS_COOKIE_DOMAIN=.meyermedia.eu
ACCESS_COOKIE_SECURE=true
ACCESS_COOKIE_SAMESITE=lax

# Generate a password hash with:
#   pnpm auth:hash
#
# Single-user shorthand:
# ACCESS_LOCAL_USERNAME=mmeyer
# ACCESS_LOCAL_PASSWORD_HASH=scrypt$32768$8$1$...
# ACCESS_LOCAL_ROLES=admin,network
# ACCESS_LOCAL_EMAIL=admin@example.com
# ACCESS_LOCAL_DISPLAY_NAME=Administrator
#
# Or configure multiple users as JSON. Use a quoted YAML value in Compose.
# ACCESS_LOCAL_USERS_JSON=[{"username":"mmeyer","passwordHash":"scrypt$32768$8$1$...","roles":["admin","network"],"displayName":"Administrator"}]

# In-process login throttling. For multi-replica deployments, also rate-limit
# at Traefik or another shared edge layer because this state is per instance.
ACCESS_LOGIN_RATE_WINDOW_SECONDS=900
ACCESS_LOGIN_MAX_ATTEMPTS=8
ACCESS_LOGIN_MAX_ATTEMPTS_PER_IP=30

# -----------------------------------------------------------------------------
# Protected-app authentication mode
# -----------------------------------------------------------------------------
# Used when ACCESS_AUTH_MODE=app. The verify endpoint must return 2xx when the
# forwarded Cookie/Authorization credentials are valid, otherwise 401/403.
# It may return X-Auth-* response headers which greggorpages forwards to Traefik.
# ACCESS_APP_VERIFY_URL=http://peer-app:3000/api/auth/forward-auth
# ACCESS_APP_LOGIN_URL=/login
# ACCESS_APP_LOGIN_APPEND_RETURN_TO=true
# ACCESS_APP_LOGIN_RETURN_PARAM=returnTo
# ACCESS_APP_VERIFY_TIMEOUT_MS=5000
# ACCESS_APP_RESPONSE_HEADERS=X-Auth-User,X-Auth-Subject,X-Auth-Email,X-Auth-Name,X-Auth-Roles
#
# Optional shared credential used only on the server-to-server verify request.
# ACCESS_APP_VERIFY_API_KEY_HEADER=X-Forward-Auth-Key
# ACCESS_APP_VERIFY_API_KEY=replace-me

# -----------------------------------------------------------------------------
# App Status Gate (Middleware)
# -----------------------------------------------------------------------------
# URL that returns the current app status: public | maintenance | devmode | testing
# The middleware fetches this on every request to decide whether to block,
# show maintenance, or require login.
# -----------------------------------------------------------------------------
APP_STATUS_URL=https://datacentermods.com/api/status

# -----------------------------------------------------------------------------
# DevMode / Testing Access Passwords
# -----------------------------------------------------------------------------
# Used by the existing application-status gate. This is separate from the
# Traefik ForwardAuth Access Gateway above.
# -----------------------------------------------------------------------------
DEVMODE_PASSWORD=your-devmode-password
TESTING_PASSWORD=your-testing-password

# -----------------------------------------------------------------------------
# Deploy Middleware (/api/git-push)
# -----------------------------------------------------------------------------
GIT_PUSH_SECRET=your-webhook-secret

# Optional: Forward deploy events to another service (Discord, Slack, etc.)
WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# -----------------------------------------------------------------------------
# Self-Update (/api/self-update)
# -----------------------------------------------------------------------------
DEPLOY_BASE_PATH=/opt/docker-infra
# ALLOWED_DEPLOY_PATHS=

# -----------------------------------------------------------------------------
# Uptime Kuma Integration (also configured in design.json)
# -----------------------------------------------------------------------------
# KUMA_BASE_URL=https://status.example.com
# KUMA_API_KEY=your-kuma-api-key
